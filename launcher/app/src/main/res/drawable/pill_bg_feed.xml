<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg for the feed Home's top bar: liquid glass (light from above, a bright rim) over a faint dark base, so the
     white icons still read over bright header art. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33080A10" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#47FFFFFF" android:centerColor="#1AFFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke android:width="1dp" android:color="#73FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
